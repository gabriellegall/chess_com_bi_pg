DB_NAME     = chess
DB_USER     = admin
DB_PASSWORD = password
DB_HOST     = localhost # no update needed (static values for local development)
DB_PORT     = 5433      # no update needed (static values for local development)

HEALTHCHECK_URL          = "https://hc-ping.com/xxxx"
HEALTHCHECK_URL_DBT_TEST = "https://hc-ping.com/xxxx"

CUBE_API_SECRET   = change_me_long_random_string
# Set CUBE_DEV_MODE to false on a server: it disables the unauthenticated Playground.
CUBE_DEV_MODE     = true
CUBE_SQL_USER     = cube
CUBE_SQL_PASSWORD = password
CUBE_SQL_HOST     = localhost # no update needed (static values for local development)
CUBE_SQL_PORT     = 15432     # no update needed (static values for local development)
